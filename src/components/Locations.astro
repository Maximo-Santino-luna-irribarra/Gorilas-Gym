---
<section id="sedes" class="py-32">
  <div class="container mx-auto px-4">
    <div class="text-center mb-20">
      <h2 class="title-impact text-5xl md:text-8xl mb-4 italic">Elegí tu <span class="text-primary">Sede</span></h2>
      <p class="text-gray-500 uppercase font-black tracking-widest italic">Tres ubicaciones, una sola pasión</p>
    </div>
    
    <div class="grid lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {sedes.map(s => <LocationCard {...s} />)}
    </div>
  </div>
</section>