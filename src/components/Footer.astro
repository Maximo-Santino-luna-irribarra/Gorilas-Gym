<footer id="contacto" class="py-20 bg-dark border-t border-white/5">
  <div class="container mx-auto px-4 text-center">
    <div class="flex flex-col items-center gap-6">
      <img src="/gorilla.png" alt="Gorillas Gym" class="h-20 w-auto" />
      <h2 class="title-impact text-4xl">GORILLAS <span class="text-primary text-5xl">GYM</span></h2>
      <p class="text-gray-500 uppercase font-black italic tracking-widest text-sm max-w-md">
        Unite a la comunidad fitness más fuerte de la zona sur.
      </p>
      
      <div class="flex gap-10 mt-8">
         <a href="#inicio" class="text-xs uppercase font-black hover:text-primary transition-colors italic tracking-widest">Inicio</a>
         <a href="#servicios" class="text-xs uppercase font-black hover:text-primary transition-colors italic tracking-widest">Servicios</a>
         <a href="#sedes" class="text-xs uppercase font-black hover:text-primary transition-colors italic tracking-widest">Sedes</a>
      </div>
      
      <div class="mt-12 text-gray-700 text-[10px] uppercase font-black tracking-[0.3em]">
        © {new Date().getFullYear()} Gorillas Gym - Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>