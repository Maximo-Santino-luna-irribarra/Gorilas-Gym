---
---
<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
  <!-- Fondo con efecto de malla o gradiente -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent opacity-50"></div>
  
  <div class="container mx-auto px-4 relative z-10 text-center">
    <span class="inline-block bg-primary text-black px-4 py-1 rounded-full text-xs font-black uppercase italic mb-6">
      The Real Fitness Community
    </span>
    <h1 class="title-impact text-6xl md:text-9xl mb-6">
      ENTRENÁ <span class="text-primary">FUERTE.</span><br />
      VIVÍ <span class="text-primary">GORILLAS.</span>
    </h1>
    <p class="text-gray-400 max-w-2xl mx-auto text-lg md:text-xl uppercase font-medium tracking-wide mb-10">
      Musculación, clases grupales y el mejor ambiente urbano para llevar tu cuerpo al siguiente nivel.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href="#sedes" class="w-full sm:w-auto bg-primary text-black px-12 py-5 rounded-xl title-impact text-xl hover:shadow-[0_0_30px_rgba(255,206,15,0.3)] transition-all">
        Elegir mi Sede
      </a>
      <a href="#servicios" class="w-full sm:w-auto border-2 border-white/20 hover:border-primary px-12 py-5 rounded-xl title-impact text-xl transition-all">
        Ver Servicios
      </a>
    </div>
  </div>
</section>